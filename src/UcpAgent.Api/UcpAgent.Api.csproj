<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UcpAgent.Api</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="9.4.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.5.12" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.41" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.*" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.16.0-rc.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.11.1" />
    <PackageReference Include="Stripe.net" Version="47.*" />
    <!-- Fixar versão segura do transitivo vulnerável -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UcpAgent.Application\UcpAgent.Application.csproj" />
    <ProjectReference Include="..\UcpAgent.SharedKernel\UcpAgent.SharedKernel.csproj" />
    <ProjectReference Include="..\UcpAgent.Infrastructure\UcpAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.Catalog.MercadoLivre\UcpAgent.Catalog.MercadoLivre.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.Catalog.VtexCatalog\UcpAgent.Catalog.VtexCatalog.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.Catalog.VtexSearch\UcpAgent.Catalog.VtexSearch.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.Catalog.OpenFoodFacts\UcpAgent.Catalog.OpenFoodFacts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\plugins\UcpAgent.Catalog.MercadoLivreOrders\UcpAgent.Catalog.MercadoLivreOrders.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.Catalog.Shopify\UcpAgent.Catalog.Shopify.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.FakeCatalog\UcpAgent.FakeCatalog.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.Catalog.DummyJSON\UcpAgent.Catalog.DummyJSON.csproj" />
    <ProjectReference Include="..\plugins\UcpAgent.PriceWatcher\UcpAgent.PriceWatcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UcpAgent.Integration.Tests" />
  </ItemGroup>
</Project>

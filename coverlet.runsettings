<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Excluir assemblies que não são foco de testes unitários -->
          <Exclude>
            [UcpAgent.Api]*Mocks*,
            [UcpAgent.Api]*Adapters*,
            [UcpAgent.Api]*Endpoints*,
            [UcpAgent.Api]Program,
            [UcpAgent.Infrastructure]*,
            [UcpAgent.Catalog.*]*,
            [UcpAgent.FakeCatalog]*,
            [UcpAgent.PriceWatcher]*,
            [UcpAgent.McpServer]*,
            [*.Tests]*
          </Exclude>
          <!-- Incluir apenas Domain, Application e SharedKernel -->
          <Include>
            [UcpAgent.Domain]*,
            [UcpAgent.Application]*,
            [UcpAgent.SharedKernel]*
          </Include>
          <ExcludeByFile>**/Program.cs,**/Migrations/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
# ── Banco de Dados ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=sua_senha_aqui

# ── Redis ─────────────────────────────────────────────────────────────────────
ConnectionStrings__Redis=comprai-redis:6379,connectTimeout=2000,syncTimeout=2000,abortConnect=false
USAR_REDIS=true

# ── Kafka ─────────────────────────────────────────────────────────────────────
USAR_KAFKA=true

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
USAR_RABBITMQ=true

# ── Feature Flags ─────────────────────────────────────────────────────────────
Features__UsarMockDados=false
Features__UsarRedis=true
Features__UsarKafka=true
Features__UsarRabbitMQ=true
Features__UsarPostgres=true

# ── Observabilidade ───────────────────────────────────────────────────────────
OTEL_ENDPOINT=http://comprai-otel-collector:4318
DD_API_KEY=sua_chave_datadog
NEW_RELIC_LICENSE_KEY=sua_chave_newrelic
NEW_RELIC_USER_KEY=sua_chave_user_newrelic
NEW_RELIC_ACCOUNT_ID=seu_account_id

# ── Integrações externas ──────────────────────────────────────────────────────
ML_CLIENT_ID=seu_client_id_ml
ML_CLIENT_SECRET=seu_client_secret_ml
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_STORE_URL=comprai-dev.myshopify.com
RESEND_API_KEY=re_xxx
Resend__FromEmail=seu@email.com

# ── Segurança ─────────────────────────────────────────────────────────────────
ADMIN_RESTART_PASSWORD=sua_senha_admin
GH_PAT=ghp_xxx
# NextAuth v5: gere com `openssl rand -base64 32`
AUTH_SECRET=sua_auth_secret_aqui

# ── Versão ────────────────────────────────────────────────────────────────────
BUILD_VERSION=1.0.0

{
  "stryker-config": {
    "project-info": {
      "name": "comprai",
      "version": "main"
    },
    "solution": "comprai.sln",
    "target-framework": "net10.0",
    "mutation-level": "Standard",
    "reporters": ["json", "progress"],
    "report-file-name": "mutation-report",
    "output-path": "StrykerOutput",
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "test-projects": [
      "tests/UcpAgent.Tests/UcpAgent.Tests.csproj"
    ],
    "source-projects": [
      "src/UcpAgent.Application/UcpAgent.Application.csproj",
      "src/UcpAgent.Domain/UcpAgent.Domain.csproj"
    ],
    "ignore-methods": [
      "ToString",
      "GetHashCode",
      "Equals"
    ],
    "excluded-mutations": [
      "StringMutation"
    ]
  }
}
{
  "stryker-config": {
    "project-info": {
      "name": "comprai",
      "version": "main"
    },
    "solution": "comprai.sln",
    "mutation-level": "Standard",
    "reporters": ["json", "progress"],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "project": "UcpAgent.Application/UcpAgent.Application.csproj",
    "test-projects": [
      "tests/UcpAgent.Tests/UcpAgent.Tests.csproj"
    ],
    "ignore-methods": [
      "ToString",
      "GetHashCode",
      "Equals"
    ]
  }
}
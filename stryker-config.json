{
  "stryker-config": {
    "project-info": {
      "name": "comprai",
      "version": "main"
    },
    "mutation-level": "Standard",
    "reporters": ["json", "progress"],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "ignore-methods": [
      "ToString",
      "GetHashCode",
      "Equals"
    ],
    "mutate": [
      "src/UcpAgent.Application/**/*.cs",
      "!src/UcpAgent.Application/**/*Command.cs",
      "!src/UcpAgent.Application/**/*Query.cs",
      "!src/UcpAgent.Application/**/*Service.cs",
      "!src/UcpAgent.Application/**/I*.cs",
      "!src/UcpAgent.Application/**/*Type.cs",
      "!src/UcpAgent.Application/**/*Result.cs"
    ]
  }
}
